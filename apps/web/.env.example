# Supabase (D9 — new sb_publishable_/sb_secret_ key scheme only).
# Publishable keys are safe to expose; this is the real value for project
# yklhpbhfowuvxlwlalhf (fetched via the Supabase MCP get_publishable_keys).
NEXT_PUBLIC_SUPABASE_URL=https://yklhpbhfowuvxlwlalhf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KfMXKnIckwNti_pzbKJ18w_iKYoVtnj

# Server-only. sb_secret_... — never NEXT_PUBLIC_, never committed with a
# real value. Founder supplies this locally / in Vercel project env vars.
SUPABASE_SECRET_KEY=

# Cloudflare KV write-through for dynamic-code retarget/pause (P5-U1,
# apps/web/lib/kv-sync.ts; docs/DECISIONS.md D2). Server-only, never
# NEXT_PUBLIC_. Land with real values in P5-U3 once the KV namespace and API
# token exist (docs/guides/p5-dynamic.md) — until then, leaving any of the
# three unset makes the sync a no-op (never blocks or fails an action).
# Cloudflare account id (docs/guides/infra.md).
CF_ACCOUNT_ID=
# KV namespace id created in P5-U3 for slug -> { destination, paused } records.
CF_KV_NAMESPACE_ID=
# API token scoped to Workers KV Storage:Edit on the namespace above.
CF_KV_API_TOKEN=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrcdn-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  // Required by @sentry/cloudflare (P8-U2), not optional: the SDK imports
  // `node:async_hooks` (for AsyncLocalStorage-based request-scoped context)
  // at module load, and Workers only resolves `node:*` specifiers with this
  // flag set — without it, `withSentry` would fail to load in the real
  // Workers runtime even with SENTRY_DSN empty (unlike the vars/DSN check
  // below, this isn't something the SDK can no-op around at request time).
  // `compatibility_date` above is already past the 2024-09-23 requirement
  // this flag needs (developers.cloudflare.com/workers/runtime-apis/nodejs).
  "compatibility_flags": ["nodejs_compat"],
  // Route is still commented out — U3 (orchestrator) flips it live once DNS
  // cuts over (apex qrcdn.com orange-clouded + this route, docs/guides/
  // infra.md "DNS / domain topology"). Uncommenting this without the DNS
  // side being ready would just 404/error at the edge; wiring the route and
  // Route flipped live at P5-U3 cutover (apex AAAA 100:: proxied + this
  // route = the Worker owns every qrcdn.com path; www is grey-cloud CNAME
  // to Vercel per D1).
  "routes": [{ "pattern": "qrcdn.com/*", "zone_name": "qrcdn.com" }],
  // Pinned to the account that owns the qrcdn.com zone ("Will Gibson") —
  // the founder's login also spans a second account (Partyreel Team), and
  // without this pin wrangler deployed there once, where the zone route
  // can't attach.
  "account_id": "7982310e22cd9430e06c34942acf3b9a",
  "kv_namespaces": [
    { "binding": "KV", "id": "1bad31228c81471a912e764aebabbbbe" },
  ],
  // Non-secret: the Supabase project's REST base URL (public — same value
  // as NEXT_PUBLIC_SUPABASE_URL in apps/web).
  "vars": {
    "SUPABASE_URL": "https://yklhpbhfowuvxlwlalhf.supabase.co",
    // Non-secret (a DSN is a publishable write-only ingestion endpoint
    // identifier, not a credential — same posture as NEXT_PUBLIC_SENTRY_DSN
    // in apps/web). P8-U2: no Sentry account exists yet, so this is left
    // empty on purpose. Empty = withSentry() in index.ts is a complete
    // no-op (verified against SDK source, not assumed — see that call
    // site); the board fills this in once a Sentry project exists.
    "SENTRY_DSN": "",
  },
  // SUPABASE_SECRET_KEY (sb_secret_...) and SCAN_SALT are Worker secrets —
  // `wrangler secret put SUPABASE_SECRET_KEY` / `wrangler secret put
  // SCAN_SALT` — NEVER committed here (infra guide "Env var conventions").
  "observability": { "enabled": true },
}

# Supabase (D9 — new sb_publishable_/sb_secret_ key scheme only).
# Publishable keys are safe to expose; this is the real value for project
# yklhpbhfowuvxlwlalhf (fetched via the Supabase MCP get_publishable_keys).
NEXT_PUBLIC_SUPABASE_URL=https://yklhpbhfowuvxlwlalhf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KfMXKnIckwNti_pzbKJ18w_iKYoVtnj

# Server-only. sb_secret_... — never NEXT_PUBLIC_, never committed with a
# real value. Founder supplies this locally / in Vercel project env vars.
SUPABASE_SECRET_KEY=

# KV write-through for dynamic-code retarget/pause (apps/web/lib/kv-sync.ts;
# docs/DECISIONS.md D2). Server-only, never NEXT_PUBLIC_. PUTs to the redirect
# Worker's first-party sync endpoint (workers/redirect/src/kv-sync-endpoint.ts)
# authenticated by this shared secret — must equal the Worker's SYNC_SECRET
# (`wrangler secret put SYNC_SECRET`). Unset = typed no-op; retargets then
# rely on the Worker's 5-minute backfill TTL.
KV_SYNC_SECRET=
# Optional base override for staging; defaults to https://qrcdn.com
# KV_SYNC_URL=

# Guards /api/cron/purge (entitlement-driven scan_events retention purge,
# D8/P6-U2). Vercel Cron sends this automatically as
# `Authorization: Bearer <value>` once set as a project env var
# (apps/web/vercel.json schedules the daily hit). Server-only, never
# NEXT_PUBLIC_. Unset = endpoint answers 404 (same disabled-endpoint stance
# as KV_SYNC_SECRET above).
CRON_SECRET=

# Sentry error monitoring (P8-U2). A DSN is publishable, not a secret —
# NEXT_PUBLIC_ is correct here, same posture as the Supabase publishable key
# above. No Sentry account/project exists yet (the board provisions one
# later); until this is set, instrumentation.ts/instrumentation-client.ts
# and the withSentryConfig wrap in next.config.ts are all a complete no-op
# (verified: `pnpm --filter web build` with this unset produces zero
# Sentry-related output). Source-map upload is deliberately NOT configured
# here — it needs a separate SENTRY_AUTH_TOKEN org auth token (plus
# SENTRY_ORG/SENTRY_PROJECT), which is a distinct, later setup step from
# just turning monitoring on.
NEXT_PUBLIC_SENTRY_DSN=

# Google Safe Browsing v4, malicious-destination screening on mint/retarget
# (D14 abuse control, P8-U5, lib/safe-browsing.ts). Server-only, never
# NEXT_PUBLIC_. No Google Cloud project/key exists yet (the board provisions
# one later) — until this is set, checkUrlSafety() is a complete no-op
# (zero network calls, every destination proceeds) and every codes-core.ts
# call site fails open the same way.
SAFE_BROWSING_API_KEY=

# Cloudflare Turnstile, sign-in bot/abuse protection (D14 abuse control,
# P8-U5, components/auth/login-form.tsx). The site key is publishable, not a
# secret — NEXT_PUBLIC_ is correct here, same posture as the Sentry DSN
# above. No Turnstile site exists yet; until this is set, the login form
# renders with no widget/script tag at all (verified: identical to the
# pre-P8-U5 form). The Turnstile SECRET key is never set here — it goes into
# Supabase's own dashboard (Project Settings -> Auth -> Bot and Abuse
# Protection), which verifies the token natively; this repo has no
# siteverify endpoint of its own.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
